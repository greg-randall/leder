# Source-Linking Pipeline — Environment Configuration
# Copy this file to .env and fill in your keys.
# cp .env.example .env

# DeepSeek (recommended — cheap, high throughput)
# Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-...

# Or use Anthropic directly — set ANTHROPIC_API_KEY instead
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: force a specific provider (default: auto-detected from key)
# ANTHROPIC_PROVIDER=deepseek

# Optional: override models per stage (see pipeline/config.yaml)
# Stage A/B models are set in config.yaml, but you can override here:
# ANTHROPIC_MODEL=deepseek-v4-pro[1m]
