.env
docs/
*.7z
laws/
local-files/
sample-code/
debug/
__pycache__/
*.pyc
~$*
.pytest_cache/
web_cache/

# Corpus directory — ships empty, users add their own source files
/corpus/*
!/corpus/.gitkeep

# Generated output — claims, sourced articles, exports
/claims*.json
/article*.md
/article*.html
/article*.docx
/*.json
/*.md
/*.html
/*.docx

# But keep these source files
!/.gitignore
!/README.md
~$*
