.env
config.yaml
docs/

# Archives — backup zips etc. shouldn't be committed (may contain
# pre-purge history, corpus data, or other things not meant for git).
*.7z
*.zip
*.tar
*.tar.*
*.tgz
*.rar

laws/
local-files/
sample-code/
debug/
__pycache__/
*.pyc
~$*
.pytest_cache/
web_cache/

# Corpus directory — ships empty, users add their own source files
/corpus/*
!/corpus/.gitkeep

# Generated output — claims, sourced articles, exports
/claims*.json
/article*.md
/article*.html
/article*.docx
/*.json
/*.md
/*.html
/*.docx
/*.txt

# But keep these source files
!/.gitignore
!/README.md
!/requirements.txt
~$*
.prereq-cache.json


# Other stuff to ignore
*.bak
*.orig
